---
import Layout from '../layouts/Layout.astro';
import { decodeJwt } from 'jose';

const token = Astro.cookies.get('auth_token')?.value;
const isLoggedIn = !!token;

let rol = '';
let aktifRol = ''; 
let aktifKullanici = '';

if (token) {
    try {
        const decoded = decodeJwt(token);
        rol = decoded.rol as string;
        aktifRol = decoded.rol as string; 
        aktifKullanici = decoded.kullaniciAdi as string;
    } catch (error) {}
}
---

<Layout title="Büşra Pilates Center Keçiören | Randevu Sistemi">

    <style is:global>
        :root {
            --manu-teal: #6B4C63;        /* Kurumsal Mürdüm */
            --manu-teal-light: #9E6B8E;  /* Yumuşak Lila/Mürdüm */
            --manu-gold: #E563B1;        /* Canlı Gül Pembe */
            --manu-bg: #FDF5FA;          /* Çok Açık Pudra */
        }
        
        .btn-manu { background-color: var(--manu-teal); color: white; border: none; }
        .btn-manu:hover { background-color: #52384b; color: white; }
        
        select:disabled {
            background-color: #e9ecef !important;
            border-color: #ced4da !important;
            color: #495057 !important;
            opacity: 1;
            cursor: not-allowed;
        }
        .gun-secim-btn:checked + label {
            background-color: var(--manu-gold) !important;
            border-color: var(--manu-gold) !important;
            color: white !important;
        }
        #mesajMerkeziModal .nav-pills .nav-link.active {
            background-color: var(--manu-teal) !important;
            color: white !important;
        }
    </style>

    {!isLoggedIn ? (
        <div id="loginEkrani" class="position-fixed w-100 h-100 d-flex flex-column justify-content-center align-items-center" style="background-color: var(--manu-teal); z-index: 9999; top: 0; left: 0;">
            <div class="card shadow-lg border-0 rounded-4 mb-3" style="width: 100%; max-width: 420px;">
                <div class="card-body p-5 text-center">
                    <img src="/logo.png" alt="Büşra Pilates Center Keçiören" style="max-height: 110px; width: auto;" class="mb-3">
                    <h4 class="fw-bold mb-1" style="color: var(--manu-teal);">Büşra Pilates Center</h4>
                    <p class="text-muted small mb-1 fw-semibold">Keçiören Şubesi</p>
                    <p class="text-muted small fst-italic mb-3">per aspera ad astra</p>
                    <form id="loginForm">
                        <div class="form-floating mb-3 text-start">
                            <input type="text" class="form-control fw-bold border-secondary" id="kullaniciAdi" placeholder="Kullanıcı Adı" required>
                            <label for="kullaniciAdi"><i class="fa-solid fa-user text-muted me-1"></i> Kullanıcı Adı</label>
                        </div>
                        <div class="form-floating mb-4 text-start">
                            <input type="password" class="form-control fw-bold border-secondary" id="sifre" placeholder="Şifre" required>
                            <label for="sifre"><i class="fa-solid fa-lock text-muted me-1"></i> Şifre</label>
                        </div>
                        <button type="submit" id="loginBtn" class="btn btn-manu w-100 py-3 fw-bold fs-5 rounded-3 shadow-sm">GİRİŞ YAP</button>
                    </form>
                </div>
            </div>
            
            <div class="text-center text-white-50 mt-3" style="opacity: 0.85;">
                <small class="text-uppercase" style="letter-spacing: 1px; font-size: 0.7rem;">Yazılım ve Altyapı</small><br>
                <div class="d-flex align-items-center justify-content-center mt-1 gap-2">
                    <img src="/ans-logo.png" alt="ANS Yazılım" style="height: 24px;" onerror="this.style.display='none'">
                    <span class="fw-bold text-white fs-6" style="letter-spacing: 0.5px;">ANS Yazılım & Veri Çözümleri</span>
                </div>
            </div>
        </div>
    ) : (
        <div id="anaSistem" style="background-color: var(--manu-bg); min-height: 100vh;">
            <div id="authVerileri" data-kullanici={aktifKullanici} data-rol={aktifRol} class="d-none"></div>

            <div class="text-white p-2 d-flex justify-content-center align-items-center gap-3" style="background-color: #3d2838; border-bottom: 3px solid var(--manu-gold);">
                <span class="badge text-white" style="background-color: var(--manu-gold);"><i class="fa-solid fa-sparkles me-1"></i> BÜŞRA PİLATES CENTER KEÇİÖREN</span>
            </div>

            <nav class="navbar navbar-dark shadow-sm" style="background-color: var(--manu-teal);">
                <div class="container d-flex justify-content-between align-items-center">
                    <div class="navbar-brand m-0 fw-bold fs-5 d-flex align-items-center" id="navbar-title">
                        <div class="bg-white rounded p-1 px-2 me-2 d-flex align-items-center shadow-sm">
                            <img src="/logo.png" alt="Büşra Pilates Center" style="max-height: 36px;">
                        </div>
                        <span class="d-none d-sm-inline">BÜŞRA PİLATES KEÇİÖREN</span>
                    </div>
                    <button type="button" id="cikisBtn" class="btn btn-outline-light btn-sm fw-bold border-2">
                        <i class="fa-solid fa-power-off"></i> <span class="d-none d-md-inline">Çıkış</span>
                    </button>
                </div>
            </nav>
            
            <div class="container mt-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center p-3 bg-white shadow-sm rounded-4 border-start border-4 gap-2 mb-4" style="border-color: var(--manu-gold) !important;">
                    <div class="text-muted text-uppercase">
                        <i class="fa-solid fa-user-tie me-1" style="color: var(--manu-teal);"></i> <strong>{aktifRol}:</strong> {aktifKullanici}
                    </div>
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <button type="button" id="mesajMerkeziBtn" class="btn btn-sm btn-success fw-bold shadow-sm" onclick="window.mesajMerkeziAc()">
                            <i class="fa-brands fa-whatsapp me-1"></i> Mesaj Merkezi
                        </button>
                        <button class="btn btn-sm btn-outline-secondary fw-bold shadow-sm" onclick="new bootstrap.Modal(document.getElementById('sifreModal')).show()">
                            <i class="fa-solid fa-key"></i> Şifre Değiştir
                        </button>
                        <a href="/ayarlar" class="btn btn-sm btn-secondary fw-bold shadow-sm">
                            <i class="fa-solid fa-gear"></i> Ayarlar
                        </a>
                        {aktifRol === 'yonetici' && (
                            <a href="/istatistik" class="btn btn-sm text-white fw-bold shadow-sm" style="background-color: var(--manu-teal-light);">
                                <i class="fa-solid fa-chart-pie me-1"></i> İstatistik
                            </a>
                        )}
                        <a href="/rehber" class="btn btn-sm btn-outline-dark fw-bold shadow-sm">
                            <i class="fa-solid fa-address-book" style="color: var(--manu-gold);"></i> Üye Rehberi
                        </a>
                    </div>
                </div>

                <div class="date-navigator shadow-sm rounded-4 bg-white mb-3">
                    <button type="button" id="dunBtn" class="date-btn text-muted"><i class="fa-solid fa-chevron-left"></i> Dün</button>
                    <div style="position: relative; flex-grow: 1; text-align: center; cursor: pointer;" id="tarihSeciciAlan">
                        <h3 class="current-date" style="color: var(--manu-teal); position: relative; z-index: 1;">
                            <i class="fa-regular fa-calendar-days me-2"></i>
                            <span id="gosterilenTarih"></span>
                            <i class="fa-solid fa-caret-down ms-2" style="font-size: 0.8rem; opacity: 0.5;"></i>
                        </h3>
                        <input type="date" id="gizliTakvim" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; z-index: 2; margin: 0; padding: 0;">
                    </div>
                    <button type="button" id="yarinBtn" class="date-btn text-muted">Yarın <i class="fa-solid fa-chevron-right"></i></button>
                </div>

                <div class="table-container shadow-sm rounded-4 bg-white overflow-auto">
                    <table class="table-matrix mb-0">
                        <thead>
                            <tr id="tabloBaslikKismi">
                                <th style="width: 10%; background-color: #3d2838; color: white;"><i class="fa-regular fa-clock"></i></th>
                            </tr>
                        </thead>
                        <tbody id="tabloGövdesi"></tbody>
                    </table>
                </div>
            </div>
            
            <div class="container mt-4 mb-3 pb-3">
                <div class="d-flex flex-column justify-content-center align-items-center text-muted" style="opacity: 0.6;">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <img src="/ans-logo.png" alt="ANS Yazılım" style="height: 18px; filter: grayscale(100%);" onerror="this.style.display='none'">
                        <span class="fw-bold" style="letter-spacing: 0.5px;">ANS Yazılım & Veri Çözümleri</span>
                    </div>
                    <small style="font-size: 0.75rem;">Pilates & Stüdyo Yönetim Altyapısı</small>
                </div>
            </div>
            
            <!-- YENİ DERS / PAKET KAYIT MODALI -->
            <div class="modal fade" id="rezModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-4 border-0 shadow-lg">
                        <div class="modal-header" style="background-color: var(--manu-teal); color: white; border-radius: 15px 15px 0 0;">
                            <h5 class="modal-title fw-bold" id="rezModalBaslik"><i class="fa-solid fa-calendar-plus me-2" style="color: var(--manu-gold);"></i>Yeni Ders Kaydı</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="alert py-2 mb-3 text-center" style="border-left: 5px solid var(--manu-gold); background-color: #FDF5FA;">
                                <div class="fw-bold mb-1" style="color: var(--manu-teal);"><i class="fa-regular fa-calendar-check me-1"></i> <span id="modalTarihMetni"></span></div>
                                <span class="badge me-1 shadow-sm" style="background-color: var(--manu-teal);" id="modalSaatBadge"></span> 
                                <span class="badge shadow-sm" style="background-color: var(--manu-gold); color: #fff;" id="modalKortBadge"></span>
                            </div>
                            <form id="kayitFormu">
                                <input type="hidden" id="editKayitId">
                                <input type="hidden" id="kayitSaat">
                                <input type="hidden" id="kayitKort">
                                
                                <!-- 1. ADIM: BRANŞ VE EĞİTMEN -->
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="form-label fw-bold text-muted small mb-1">1. Ders Branşı</label>
                                        <select id="kayitBrans" class="form-select border-secondary fw-bold text-dark">
                                            <option value="Reformer Pilates">Reformer Pilates</option>
                                            <option value="Mat Pilates">Mat Pilates</option>
                                            <option value="Hamile Pilatesi">Hamile Pilatesi</option>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label fw-bold text-muted small mb-1">Eğitmen</label>
                                        <select id="kayitUzman" class="form-select bg-light fw-bold" style="border-color: var(--manu-teal);" disabled></select>
                                    </div>
                                </div>

                                <!-- 2. ADIM: GRUP MU ÖZEL Mİ? -->
                                <div class="mb-3 p-2 rounded-3 border" style="background-color: #FDF5FA; border-color: #e8cce0 !important;">
                                    <label class="form-label fw-bold small mb-1 d-block" style="color: var(--manu-teal);">2. Ders Düzeni (Grup / Özel)</label>
                                    <div class="btn-group w-100" role="group">
                                        <input type="radio" class="btn-check" name="dersFormatiRadio" id="formatGrup" value="grup" checked autocomplete="off">
                                        <label class="btn btn-sm btn-outline-secondary fw-bold py-2" for="formatGrup">
                                            <i class="fa-solid fa-users me-1"></i> Grup Dersi (Max 4)
                                        </label>

                                        <input type="radio" class="btn-check" name="dersFormatiRadio" id="formatOzel" value="ozel" autocomplete="off">
                                        <label class="btn btn-sm btn-outline-secondary fw-bold py-2" for="formatOzel">
                                            <i class="fa-solid fa-user me-1"></i> Özel Ders (1 Kişi)
                                        </label>
                                    </div>
                                </div>

                                <!-- DERS TAŞIMA ALANI (Sadece Düzenleme Modunda Görünür) -->
                                <div id="duzenleTasimaAlani" class="row g-2 mb-3 p-2 rounded-3 border d-none" style="background-color: #FDF5FA; border-color: #e8cce0 !important;">
                                    <div class="col-7">
                                        <label class="form-label fw-bold small mb-1" style="color: var(--manu-teal);"><i class="fa-regular fa-calendar me-1"></i> Yeni Tarih</label>
                                        <input type="date" id="duzenleTarih" class="form-control form-control-sm fw-bold border-secondary">
                                    </div>
                                    <div class="col-5">
                                        <label class="form-label fw-bold small mb-1" style="color: var(--manu-teal);"><i class="fa-regular fa-clock me-1"></i> Yeni Saat</label>
                                        <select id="duzenleSaat" class="form-select form-select-sm fw-bold border-secondary"></select>
                                    </div>
                                </div>

                                <!-- ORTAK PAKET VE OTOMATİK GÜN SEÇİMİ (Sadece Yeni Kayıtta Görünür) -->
                                <div id="paketSecimAlani" class="mb-3 p-3 rounded-3 border" style="background-color: #FDF5FA; border-color: #e8cce0 !important;">
                                    <div class="mb-2">
                                        <label class="form-label fw-bold small mb-1" style="color: var(--manu-teal);"><i class="fa-solid fa-ticket me-1" style="color: var(--manu-gold);"></i> Paket / Seans Seçimi (Ortak)</label>
                                        <select id="kayitPaket" class="form-select form-select-sm fw-bold border-secondary">
                                            <option value="1">Tek Seans (Sadece Seçili Gün)</option>
                                            <option value="8">8 Derslik Paket (Otomatik Diz)</option>
                                            <option value="10">10 Derslik Paket (Otomatik Diz)</option>
                                            <option value="12">12 Derslik Paket (Otomatik Diz)</option>
                                            <option value="16">16 Derslik Paket (Otomatik Diz)</option>
                                        </select>
                                    </div>
                                    <div id="gunSecimKutusu" class="d-none mt-2">
                                        <label class="form-label fw-bold small text-muted mb-1 d-block">Ders Günleri (Ortak Program)</label>
                                        <div class="d-flex justify-content-between gap-1">
                                            <input type="checkbox" class="btn-check gun-secim-btn" id="gun1" value="1" autocomplete="off"><label class="btn btn-sm btn-outline-secondary flex-fill px-1 fw-bold" for="gun1">Pzt</label>
                                            <input type="checkbox" class="btn-check gun-secim-btn" id="gun2" value="2" autocomplete="off"><label class="btn btn-sm btn-outline-secondary flex-fill px-1 fw-bold" for="gun2">Sal</label>
                                            <input type="checkbox" class="btn-check gun-secim-btn" id="gun3" value="3" autocomplete="off"><label class="btn btn-sm btn-outline-secondary flex-fill px-1 fw-bold" for="gun3">Çar</label>
                                            <input type="checkbox" class="btn-check gun-secim-btn" id="gun4" value="4" autocomplete="off"><label class="btn btn-sm btn-outline-secondary flex-fill px-1 fw-bold" for="gun4">Per</label>
                                            <input type="checkbox" class="btn-check gun-secim-btn" id="gun5" value="5" autocomplete="off"><label class="btn btn-sm btn-outline-secondary flex-fill px-1 fw-bold" for="gun5">Cum</label>
                                            <input type="checkbox" class="btn-check gun-secim-btn" id="gun6" value="6" autocomplete="off"><label class="btn btn-sm btn-outline-secondary flex-fill px-1 fw-bold" for="gun6">Cmt</label>
                                        </div>
                                        <small id="gunSecimNotu" class="text-muted d-block mt-1" style="font-size: 0.7rem;">* Seçilen günlerde doluluk veya izin varsa kayıt yapılmaz ve detay gösterilir.</small>
                                    </div>
                                </div>

                                <!-- 1. ÜYE (ZORUNLU) -->
                                <div class="p-3 rounded-3 border mb-3 bg-white">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge" style="background-color: var(--manu-teal);">1. Üye (Zorunlu)</span>
                                    </div>
                                    <div class="mb-2 position-relative">
                                        <label class="form-label fw-bold text-muted small mb-1">Üye Adı Soyadı</label>
                                        <input type="text" id="kayitAdi" class="form-control form-control-sm bg-light" style="border-color: var(--manu-teal);" placeholder="Üye İsmi Giriniz" autocomplete="off" required>
                                        <ul id="isimOnerileri" class="list-group position-absolute w-100 shadow-sm d-none" style="z-index: 1000; top: 100%;"></ul>
                                    </div>

                                    <div class="row g-2">
                                        <div class="col-7">
                                            <label class="form-label fw-bold text-muted small mb-1"><i class="fa-brands fa-whatsapp me-1" style="color: var(--manu-teal);"></i> Telefon (05XX...)</label>
                                            <input type="tel" id="kayitTelefon" class="form-control form-control-sm bg-light fw-bold" style="letter-spacing: 1px;" placeholder="05XX XXX XX XX" maxlength="14" required>
                                        </div>
                                        <div class="col-5">
                                            <label class="form-label fw-bold text-muted small mb-1"><i class="fa-solid fa-venus-mars me-1" style="color: var(--manu-gold);"></i> Cinsiyet</label>
                                            <select id="kayitCinsiyet" class="form-select form-select-sm bg-light fw-bold border-secondary">
                                                <option value="kadin">Kadın</option>
                                                <option value="erkek">Erkek</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <!-- GRUP DERSLERİNDE EK ÜYE SATIRLARI (MAX 4 KİŞİ) -->
                                <div id="grupUyelerBolumu" class="d-none mb-3">
                                    <div id="ekUyeSatirlari" class="d-flex flex-column gap-2 mb-2"></div>
                                    <button type="button" id="grupUyeEkleBtn" class="btn btn-sm btn-outline-secondary w-100 fw-bold" onclick="window.grupUyeSatiriEkle()">
                                        <i class="fa-solid fa-user-plus me-1"></i> Grup Üyesi Ekle (En Fazla 4 Kişi)
                                    </button>
                                </div>

                                <button type="submit" id="kaydetBtn" class="btn btn-manu w-100 py-3 fw-bold fs-5 rounded-3 mt-1 shadow-sm">
                                    <i class="fa-solid fa-check-double me-2"></i> KAYDET
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- DERS / GRUP DETAY MODALI -->
            <div class="modal fade" id="detayModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content rounded-4 border-0 shadow-lg">
                        <div class="modal-header" style="background-color: var(--manu-teal); color: white; border-radius: 15px 15px 0 0;">
                            <h5 class="modal-title fw-bold" id="detayModalBaslik"><i class="fa-solid fa-circle-info me-2" style="color: var(--manu-gold);"></i>Ders Detayı</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="alert py-2 mb-3 text-center" style="border-left: 5px solid var(--manu-gold); background-color: #FDF5FA;">
                                <div class="fw-bold mb-1" style="color: var(--manu-teal);"><i class="fa-regular fa-calendar-check me-1"></i> <span id="detayTarihMetni"></span></div>
                                <span class="badge me-1 shadow-sm" style="background-color: var(--manu-teal);" id="detaySaatBadge"></span> 
                                <span class="badge shadow-sm" style="background-color: var(--manu-gold); color: #fff;" id="detayKortBadge"></span>
                            </div>

                            <div id="detayUyeListesi" class="d-flex flex-column gap-2 mb-3"></div>

                            <button type="button" id="grubaEkleBtn" class="btn btn-manu w-100 py-2 fw-bold rounded-3 shadow-sm d-none">
                                <i class="fa-solid fa-user-plus me-2"></i> BU GRUBA YENİ ÜYE EKLE
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- AKILLI İPTAL & 12 SAAT KURALI MODALI -->
            <div class="modal fade" id="iptalModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-4 border-0 shadow-lg">
                        <div class="modal-header bg-danger text-white rounded-top-4">
                            <h5 class="modal-title fw-bold"><i class="fa-solid fa-trash-can me-2"></i>Ders İptali</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-4">
                            <p class="fw-bold mb-2 text-dark" id="iptalUyeBilgi"></p>
                            <div id="iptal12SaatUyari" class="alert py-2 small fw-bold mb-3"></div>

                            <div id="iptalSeriAlani" class="mb-3 d-none">
                                <label class="form-label small fw-bold text-muted">İptal Kapsamı</label>
                                <select id="iptalKapsam" class="form-select form-select-sm fw-bold border-secondary">
                                    <option value="tek">Sadece Bu Dersi İptal Et</option>
                                    <option value="seri">Bu ve Sonraki Tüm Paket Derslerini İptal Et</option>
                                </select>
                            </div>

                            <div id="iptalHakAlani" class="mb-3">
                                <label class="form-label small fw-bold text-muted">Ders Hakkı / Telafi İşlemi</label>
                                <select id="iptalHakSecim" class="form-select form-select-sm fw-bold border-secondary">
                                    <option value="telafi">Paketin Sonuna 1 Telafi Dersi Otomatik Ekle</option>
                                    <option value="evet">Ders Hakkını İade Et (+1 Kalan Ders)</option>
                                    <option value="hayir">Hak İade Etme (Ders Yansın)</option>
                                </select>
                            </div>

                            <div class="d-flex gap-2 mt-4">
                                <button type="button" class="btn btn-light border fw-bold flex-fill" data-bs-dismiss="modal">Vazgeç</button>
                                <button type="button" id="iptalOnaylaBtn" class="btn btn-danger fw-bold flex-fill">
                                    <i class="fa-solid fa-check me-1"></i> İPTALİ ONAYLA
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- MESAJ MERKEZİ POP-UP MODALI -->
            <div class="modal fade" id="mesajMerkeziModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content rounded-4 border-0 shadow-lg">
                        <div class="modal-header text-white" style="background-color: #3d2838; border-bottom: 3px solid var(--manu-gold); border-radius: 15px 15px 0 0;">
                            <h5 class="modal-title fw-bold"><i class="fa-brands fa-whatsapp me-2" style="color: #25D366;"></i>Mesaj Merkezi</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-4" style="background-color: var(--manu-bg);">
                            
                            <ul class="nav nav-pills nav-fill bg-white p-2 rounded-4 shadow-sm mb-4 gap-2" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active fw-bold py-2" data-bs-toggle="pill" data-bs-target="#mmYarinPanel" type="button" style="color: var(--manu-teal);">
                                        <i class="fa-regular fa-clock me-1"></i> Yarının Hatırlatmaları <span id="mmYarinSayac" class="badge bg-dark ms-1">0</span>
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link fw-bold py-2" data-bs-toggle="pill" data-bs-target="#mmPaketPanel" type="button" style="color: var(--manu-teal);">
                                        <i class="fa-solid fa-ticket me-1"></i> Paketi Azalanlar <span id="mmPaketSayac" class="badge bg-danger ms-1">0</span>
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link fw-bold py-2" data-bs-toggle="pill" data-bs-target="#mmTopluPanel" type="button" style="color: var(--manu-teal);">
                                        <i class="fa-solid fa-bullhorn me-1"></i> Özel Gün & Toplu Duyuru
                                    </button>
                                </li>
                            </ul>

                            <div class="tab-content">
                                <!-- SEKME 1: YARININ HATIRLATMALARI -->
                                <div class="tab-pane fade show active" id="mmYarinPanel">
                                    <div class="card border-0 shadow-sm rounded-4 p-3">
                                        <p class="text-muted small mb-3">Tarih: <strong id="mmYarinTarih" class="text-dark"></strong></p>
                                        <div id="mmYarinListesi"></div>
                                    </div>
                                </div>

                                <!-- SEKME 2: PAKETİ AZALANLAR -->
                                <div class="tab-pane fade" id="mmPaketPanel">
                                    <div class="card border-0 shadow-sm rounded-4 p-3">
                                        <p class="text-muted small mb-3">Kalan ders hakkı <strong>2 ve altına</strong> düşen üyeler otomatik listelenir.</p>
                                        <div id="mmPaketListesi"></div>
                                    </div>
                                </div>

                                <!-- SEKME 3: ÖZEL GÜN & TOPLU DUYURU -->
                                <div class="tab-pane fade" id="mmTopluPanel">
                                    <div class="row g-3">
                                        <div class="col-lg-5">
                                            <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
                                                <div class="mb-2">
                                                    <label class="form-label small fw-bold text-muted">Hazır Şablon</label>
                                                    <select id="mmSablonSec" class="form-select form-select-sm fw-bold border-secondary">
                                                        <option value="serbest">Serbest Metin</option>
                                                        <option value="bayram">Bayram Tebriği</option>
                                                        <option value="kadinlar">8 Mart Kadınlar Günü</option>
                                                        <option value="yilbasi">Yeni Yıl Tebriği</option>
                                                        <option value="tatil">Stüdyo Tatil / Kapanış Duyurusu</option>
                                                    </select>
                                                </div>
                                                <div class="mb-2">
                                                    <label class="form-label small fw-bold text-muted">Hedef Kitle</label>
                                                    <select id="mmHedefKitle" class="form-select form-select-sm fw-bold border-secondary">
                                                        <option value="tumu">Tüm Üyeler</option>
                                                        <option value="aktif">Sadece Aktif Paketi Olanlar</option>
                                                        <option value="kadin">Sadece Kadın Üyeler</option>
                                                        <option value="erkek">Sadece Erkek Üyeler</option>
                                                    </select>
                                                </div>
                                                <div class="mb-2">
                                                    <label class="form-label small fw-bold text-muted">Mesaj Metni</label>
                                                    <textarea id="mmTopluMetin" rows="5" class="form-control form-control-sm border-secondary" placeholder="Mesajınızı yazın..."></textarea>
                                                    <small class="text-muted d-block mt-1" style="font-size: 0.72rem;">İpucu: <code>{'{isim}'}</code> yazarsanız üyenin adı otomatik eklenir.</small>
                                                </div>
                                                <button type="button" class="btn btn-manu btn-sm w-100 fw-bold py-2 mt-1" onclick="window.mmKuyrukOlustur()">
                                                    <i class="fa-solid fa-list-check me-1"></i> Gönderim Listesini Hazırla
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-lg-7">
                                            <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <strong class="small" style="color: var(--manu-teal);">Gönderim Kuyruğu</strong>
                                                    <span id="mmKuyrukSayac" class="badge bg-secondary">0 Kişi</span>
                                                </div>
                                                <div id="mmKuyrukListesi" style="max-height: 340px; overflow-y: auto;">
                                                    <div class="alert alert-light border text-center text-muted small py-4">Soldan şablon ve hedef kitle seçip listeyi hazırlayın.</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    )}
</Layout>

<script is:inline>
    const GRUP_KAPASITE = 4;
    window.guncelTarih = new Date();
    window.isoTarihFormat = "";
    window.myModal = null;
    window.detayModal = null;
    window.aktifSlotKayitlari = []; 
    window.mevcutGrupKisiSayisi = 0;
    
    window.aktifEgitmenler = [];
    window.alanSayisi = 3; 
    window.saatler = [];
    window.gunlukIzindekiler = []; 

    let mmTumUyeler = [];
    let mmTumRez = [];

    const mmSablonlar = {
        serbest: '',
        bayram: 'Sayın {isim},\n\nSevdiklerinizle birlikte sağlık, huzur ve enerji dolu mutlu bir bayram geçirmenizi dileriz.\n\nBüşra Pilates Center Keçiören',
        kadinlar: 'Sayın {isim},\n\nGücünüz, zarafetiniz ve enerjinizle dünyayı güzelleştirdiğiniz için teşekkürler. 8 Mart Dünya Kadınlar Gününüz kutlu olsun!\n\nBüşra Pilates Center Keçiören',
        yilbasi: 'Sayın {isim},\n\nYeni yılın size sağlık, mutluluk ve bol hareketli harika günler getirmesini dileriz. Nice güzel yıllara!\n\nBüşra Pilates Center Keçiören',
        tatil: 'Sayın {isim},\n\nStüdyomuz [TARİH] tarihinde kapalı olacaktır. Ders programınızla ilgili sorularınız için bize yazabilirsiniz.\n\nBüşra Pilates Center Keçiören'
    };

    function saatDakikaToDk(saatStr) {
        const [s, d = '0'] = (saatStr || '00:00').split(':');
        return (parseInt(s, 10) || 0) * 60 + (parseInt(d, 10) || 0);
    }

    function bugunYerelTarihStr() {
        const simdi = new Date();
        const yil = simdi.getFullYear();
        const ay = String(simdi.getMonth() + 1).padStart(2, '0');
        const gun = String(simdi.getDate()).padStart(2, '0');
        return `${yil}-${ay}-${gun}`;
    }

    function slotGecmisSaatMi(tarihStr, saatStr) {
        const bugunTarihi = bugunYerelTarihStr();
        if (tarihStr !== bugunTarihi) return false;

        const simdi = new Date();
        const suAnkiDk = simdi.getHours() * 60 + simdi.getMinutes();
        return saatDakikaToDk(saatStr) < suAnkiDk;
    }

    function mmWpLink(telefon, mesaj) {
        const temiz = (telefon || '').replace(/\D/g, '');
        if (temiz.length < 10) return null;
        const trNumara = temiz.startsWith('0') ? '9' + temiz : '90' + temiz;
        const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        return isMobile
            ? `https://api.whatsapp.com/send?phone=${trNumara}&text=${encodeURIComponent(mesaj)}`
            : `https://web.whatsapp.com/send?phone=${trNumara}&text=${encodeURIComponent(mesaj)}`;
    }

    function seciliFormatGetir() {
        return document.querySelector('input[name="dersFormatiRadio"]:checked')?.value === 'ozel' ? 'ozel' : 'grup';
    }

    function seciliFormatAta(format) {
        const hedef = format === 'ozel' ? 'formatOzel' : 'formatGrup';
        const el = document.getElementById(hedef);
        if (el) el.checked = true;
    }

    function birlesikDersTuruOlustur(brans, format) {
        const temizBrans = (brans || 'Reformer Pilates').trim();
        if (format === 'ozel') {
            return temizBrans === 'Reformer Pilates' ? 'Reformer Pilates Özel Ders' : `${temizBrans} (Özel Ders)`;
        }
        return temizBrans === 'Reformer Pilates' ? 'Reformer Pilates Grup Ders' : `${temizBrans} (Grup Ders)`;
    }

    function kayitFormatiniBul(kayit) {
        if (kayit?.dersFormati === 'ozel' || kayit?.dersFormati === 'grup') return kayit.dersFormati;
        const t = (kayit?.rezervasyonTuru || '').toLocaleLowerCase('tr-TR');
        if (t.includes('özel') || t.includes('ozel')) return 'ozel';
        return 'grup';
    }

    function kayitBransiniBul(kayit) {
        const t = (kayit?.rezervasyonTuru || '').toLocaleLowerCase('tr-TR');
        if (t.includes('hamile')) return 'Hamile Pilatesi';
        if (t.includes('mat')) return 'Mat Pilates';
        return 'Reformer Pilates';
    }

    function cinsiyetIkonHtml(cinsiyet, kucuk = false) {
        const erkekMi = (cinsiyet || 'kadin') === 'erkek';
        const boyutClass = kucuk ? 'ms-1' : 'me-1';
        if (erkekMi) {
            return `<i class="fa-solid fa-mars ${boyutClass}" style="color: #2563eb;" title="Erkek"></i>`;
        }
        return `<i class="fa-solid fa-venus ${boyutClass}" style="color: #db2777;" title="Kadın"></i>`;
    }

    function bransIkonHtml(kayit) {
        const brans = kayitBransiniBul(kayit);
        if (brans === 'Hamile Pilatesi') {
            return `<i class="fa-solid fa-person-pregnant me-1" style="color: var(--manu-gold);" title="Hamile Pilatesi"></i>`;
        }
        if (brans === 'Mat Pilates') {
            return `<i class="fa-solid fa-child-reaching me-1" style="color: var(--manu-teal-light);" title="Mat Pilates"></i>`;
        }
        return `<i class="fa-solid fa-dumbbell me-1" style="color: var(--manu-teal);" title="Reformer Pilates"></i>`;
    }

    function kalanDersRozetHtml(kalanDers, kucuk = false) {
        if (kalanDers === null || kalanDers === undefined) return '';
        const adet = Number(kalanDers);
        if (Number.isNaN(adet)) return '';

        const renkClass = adet <= 0 ? 'bg-danger' : (adet <= 2 ? 'bg-warning text-dark' : 'bg-secondary');
        const boyutClass = kucuk ? 'ms-1' : 'ms-2';
        const metin = adet <= 0 ? '0 kaldı' : `${adet} ders`;
        return `<span class="badge ${renkClass} ${boyutClass}" style="font-size: ${kucuk ? '0.62rem' : '0.72rem'};" title="Kalan Ders Hakkı">${metin}</span>`;
    }

    function isGrupKayit(kayit) {
        return kayitFormatiniBul(kayit) === 'grup';
    }

    function isimFormatla(isim) {
        if (!isim) return "";
        const parcalar = isim.trim().split(/\s+/);
        if (parcalar.length === 1) {
            return parcalar[0].charAt(0).toLocaleUpperCase('tr-TR') + parcalar[0].slice(1).toLocaleLowerCase('tr-TR');
        }
        const sonKelime = parcalar.pop().toLocaleUpperCase('tr-TR');
        const ilkKisim = parcalar.map(p => p.charAt(0).toLocaleUpperCase('tr-TR') + p.slice(1).toLocaleLowerCase('tr-TR')).join(' ');
        return ilkKisim + ' ' + sonKelime;
    }

    function telefonMaskele(deger) {
        let val = (deger || '').replace(/\D/g, '');
        if (val.length > 0 && val[0] !== '0') val = '0' + val;
        if (val.length > 1 && val[1] !== '5') val = val.substring(0, 1) + '5' + val.substring(2);
        let res = '';
        if (val.length > 0) res += val.substring(0, 4);
        if (val.length > 4) res += ' ' + val.substring(4, 7);
        if (val.length > 7) res += ' ' + val.substring(7, 9);
        if (val.length > 9) res += ' ' + val.substring(9, 11);
        return res;
    }

    function grupUyeleriSifirla() {
        const konteyner = document.getElementById('ekUyeSatirlari');
        if (konteyner) konteyner.innerHTML = '';
        grupUyeGorunurlukGuncelle();
    }

    function grupUyeGorunurlukGuncelle() {
        const bolum = document.getElementById('grupUyelerBolumu');
        const ekleBtn = document.getElementById('grupUyeEkleBtn');
        const editId = document.getElementById('editKayitId')?.value;
        const formatGrupMu = seciliFormatGetir() === 'grup';
        const konteyner = document.getElementById('ekUyeSatirlari');
        if (!bolum || !konteyner) return;

        const kalanKapasite = Math.max(1, GRUP_KAPASITE - (window.mevcutGrupKisiSayisi || 0));

        if (!editId && formatGrupMu && kalanKapasite > 1) {
            bolum.classList.remove('d-none');
            const formdakiKisi = 1 + konteyner.children.length;
            const toplamGrup = (window.mevcutGrupKisiSayisi || 0) + formdakiKisi;
            if (ekleBtn) {
                ekleBtn.classList.toggle('d-none', formdakiKisi >= kalanKapasite);
                ekleBtn.innerHTML = `<i class="fa-solid fa-user-plus me-1"></i> Grup Üyesi Ekle (${toplamGrup}/${GRUP_KAPASITE} Kişi)`;
            }
        } else {
            bolum.classList.add('d-none');
            konteyner.innerHTML = '';
        }
    }

    function grupUyeNumaralandir() {
        const baslangicNo = (window.mevcutGrupKisiSayisi || 0) + 2;
        document.querySelectorAll('#ekUyeSatirlari .ek-uye-satir').forEach((satir, i) => {
            const rozet = satir.querySelector('.badge');
            if (rozet) rozet.textContent = `${baslangicNo + i}. Üye (İsteğe Bağlı)`;
        });
    }

    window.grupUyeSatiriEkle = function() {
        const konteyner = document.getElementById('ekUyeSatirlari');
        const kalanKapasite = Math.max(1, GRUP_KAPASITE - (window.mevcutGrupKisiSayisi || 0));
        const formdakiKisi = 1 + konteyner.children.length;
        if (formdakiKisi >= kalanKapasite) return;

        const sira = (window.mevcutGrupKisiSayisi || 0) + formdakiKisi + 1;
        const satir = document.createElement('div');
        satir.className = 'p-3 rounded-3 border bg-white ek-uye-satir';
        satir.innerHTML = `
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge" style="background-color: var(--manu-teal-light);">${sira}. Üye (İsteğe Bağlı)</span>
                <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="this.closest('.ek-uye-satir').remove(); grupUyeNumaralandir(); grupUyeGorunurlukGuncelle();" title="Satırı Kaldır">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="mb-2 position-relative">
                <input type="text" class="form-control form-control-sm bg-light ek-uye-ad" placeholder="Üye Adı Soyadı" autocomplete="off" required>
                <ul class="list-group position-absolute w-100 shadow-sm d-none ek-uye-oneriler" style="z-index: 1000; top: 100%;"></ul>
            </div>
            <div class="row g-2">
                <div class="col-7">
                    <input type="tel" class="form-control form-control-sm bg-light fw-bold ek-uye-tel" style="letter-spacing: 1px;" placeholder="05XX XXX XX XX" maxlength="14" required>
                </div>
                <div class="col-5">
                    <select class="form-select form-select-sm bg-light fw-bold border-secondary ek-uye-cinsiyet">
                        <option value="kadin">Kadın</option>
                        <option value="erkek">Erkek</option>
                    </select>
                </div>
            </div>
        `;

        const telInput = satir.querySelector('.ek-uye-tel');
        telInput.addEventListener('input', function (e) {
            e.target.value = telefonMaskele(e.target.value);
        });

        const adInput = satir.querySelector('.ek-uye-ad');
        const oneriUl = satir.querySelector('.ek-uye-oneriler');
        let timer;

        adInput.addEventListener('blur', function(e) { e.target.value = isimFormatla(e.target.value); });
        adInput.addEventListener('input', (e) => {
            clearTimeout(timer);
            if (e.target.value.length < 2) { oneriUl.classList.add('d-none'); return; }
            timer = setTimeout(async () => {
                const res = await fetch(`/api/musteri-ara?q=${e.target.value}`);
                const musteriler = await res.json();
                oneriUl.innerHTML = '';
                if (musteriler.length > 0) {
                    musteriler.forEach(m => {
                        const li = document.createElement('li');
                        li.className = 'list-group-item list-group-item-action cursor-pointer d-flex justify-content-between align-items-center';
                        li.innerHTML = `<span class="fw-bold" style="color: var(--manu-teal);">${m.adSoyad}</span> <span class="badge bg-light text-dark border">${m.telefon}</span>`;
                        li.addEventListener('click', () => {
                            adInput.value = m.adSoyad;
                            telInput.value = m.telefon;
                            if (m.cinsiyet) satir.querySelector('.ek-uye-cinsiyet').value = m.cinsiyet;
                            oneriUl.classList.add('d-none');
                        });
                        oneriUl.appendChild(li);
                    });
                    oneriUl.classList.remove('d-none');
                } else {
                    oneriUl.classList.add('d-none');
                }
            }, 300);
        });

        document.addEventListener('click', (e) => {
            if (e.target !== adInput && e.target !== oneriUl) oneriUl.classList.add('d-none');
        });

        konteyner.appendChild(satir);
        grupUyeNumaralandir();
        grupUyeGorunurlukGuncelle();
    };

    function egitmenByKort(kortNo) {
        return window.aktifEgitmenler[kortNo - 1] || window.aktifEgitmenler[0] || {
            anahtar: 'ilayda',
            adSoyad: 'İlayda Hoca',
            baslangicSaati: 9,
            bitisSaati: 17,
            renk: '#6B4C63'
        };
    }

    function egitmenByAnahtar(anahtar) {
        return window.aktifEgitmenler.find(e => e.anahtar === anahtar) || null;
    }

    function basliklariCiz() {
        const tr = document.getElementById('tabloBaslikKismi');
        if (!tr) return;
        const genislik = Math.max(12, Math.floor(90 / Math.max(1, window.alanSayisi)));
        let html = `<th style="width: 10%; background-color: #3d2838; color: white;"><i class="fa-regular fa-clock"></i></th>`;
        window.aktifEgitmenler.forEach(eg => {
            const bas = String(eg.baslangicSaati).padStart(2, '0') + ':00';
            const bit = String(eg.bitisSaati).padStart(2, '0') + ':00';
            html += `<th style="width: ${genislik}%; background-color: ${eg.renk || '#6B4C63'} !important; color: white !important; border-bottom: 3px solid rgba(0,0,0,0.2) !important;" class="align-middle text-center">${eg.adSoyad.toLocaleUpperCase('tr-TR')}<br><small class="fw-normal opacity-75">${bas}-${bit}</small></th>`;
        });
        tr.innerHTML = html;

        const uzmanSelect = document.getElementById('kayitUzman');
        if (uzmanSelect) {
            uzmanSelect.innerHTML = window.aktifEgitmenler.map(eg => `<option value="${eg.anahtar}">${eg.adSoyad}</option>`).join('');
        }

        const kitleSelect = document.getElementById('mmHedefKitle');
        if (kitleSelect) {
            kitleSelect.innerHTML = `
                <option value="tumu">Tüm Üyeler</option>
                <option value="aktif">Sadece Aktif Paketi Olanlar</option>
                <option value="kadin">Sadece Kadın Üyeler</option>
                <option value="erkek">Sadece Erkek Üyeler</option>
                ${window.aktifEgitmenler.map(eg => `<option value="${eg.anahtar}">${eg.adSoyad}'nın Üyeleri</option>`).join('')}
            `;
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        const loginForm = document.getElementById('loginForm');
        if (loginForm) {
            loginForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = document.getElementById('loginBtn');
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> GİRİŞ YAPILIYOR...';
                try {
                    const res = await fetch('/api/login', {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ kullaniciAdi: document.getElementById('kullaniciAdi').value, sifre: document.getElementById('sifre').value })
                    });
                    if (res.ok) window.location.reload(); 
                    else { alert((await res.json()).error); btn.innerHTML = 'GİRİŞ YAP'; }
                } catch(err) { alert("Sunucu hatası."); }
            });
        }

        if (document.getElementById('cikisBtn')) {
            document.getElementById('cikisBtn').addEventListener('click', async () => {
                await fetch('/api/logout', { method: 'POST' });
                window.location.reload();
            });
        }

        if (document.getElementById('anaSistem')) {
            window.aktifKullanici = document.getElementById('authVerileri').getAttribute('data-kullanici');
            window.aktifRol = document.getElementById('authVerileri').getAttribute('data-rol');

            baslatSistemi();

            document.getElementById('dunBtn').addEventListener('click', () => tarihDegistir(-1));
            document.getElementById('yarinBtn').addEventListener('click', () => tarihDegistir(1));
            
            const gizliTakvim = document.getElementById('gizliTakvim');
            gizliTakvim.addEventListener('change', (e) => tarihiGuncelle(e.target.value));
            gizliTakvim.addEventListener('click', function() { try { this.showPicker(); } catch (err) {} });

            document.getElementById('kayitPaket').addEventListener('change', function() {
                const kutu = document.getElementById('gunSecimKutusu');
                if (parseInt(this.value) > 1) kutu.classList.remove('d-none');
                else kutu.classList.add('d-none');
            });

            document.querySelectorAll('input[name="dersFormatiRadio"]').forEach(r => {
                r.addEventListener('change', grupUyeGorunurlukGuncelle);
            });

            const telInput = document.getElementById('kayitTelefon');
            if(telInput) {
                telInput.addEventListener('input', function (e) {
                    e.target.value = telefonMaskele(e.target.value);
                });
            }

            const isimInput = document.getElementById('kayitAdi');
            const oneriListesi = document.getElementById('isimOnerileri');
            let aramaZamanlayici;

            isimInput.addEventListener('blur', function(e) { e.target.value = isimFormatla(e.target.value); });

            isimInput.addEventListener('input', (e) => {
                clearTimeout(aramaZamanlayici);
                if (e.target.value.length < 2) { oneriListesi.classList.add('d-none'); return; }
                aramaZamanlayici = setTimeout(async () => {
                    const res = await fetch(`/api/musteri-ara?q=${e.target.value}`);
                    const musteriler = await res.json();
                    oneriListesi.innerHTML = '';
                    if (musteriler.length > 0) {
                        musteriler.forEach(m => {
                            const li = document.createElement('li');
                            li.className = 'list-group-item list-group-item-action cursor-pointer d-flex justify-content-between align-items-center';
                            const krediRozeti = (m.kalanDers !== undefined && m.kalanDers !== null)
                                ? `<span class="badge ms-2 ${m.kalanDers <= 2 ? 'bg-danger' : 'bg-success'}">Kalan: ${m.kalanDers}</span>` : '';
                            li.innerHTML = `<div><span class="fw-bold" style="color: var(--manu-teal);">${m.adSoyad}</span>${krediRozeti}</div> <span class="badge bg-light text-dark border">${m.telefon}</span>`;
                            li.addEventListener('click', () => {
                                isimInput.value = m.adSoyad;
                                document.getElementById('kayitTelefon').value = m.telefon;
                                if (m.cinsiyet) document.getElementById('kayitCinsiyet').value = m.cinsiyet;
                                oneriListesi.classList.add('d-none');
                            });
                            oneriListesi.appendChild(li);
                        });
                        oneriListesi.classList.remove('d-none');
                    } else oneriListesi.classList.add('d-none');
                }, 300);
            });
            document.addEventListener('click', (e) => { if(e.target !== isimInput && e.target !== oneriListesi) oneriListesi.classList.add('d-none'); });

            document.getElementById('kayitFormu').addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = document.getElementById('kaydetBtn');
                const guncelTel = document.getElementById('kayitTelefon').value;
                if(guncelTel && guncelTel.length < 14) { alert("Lütfen numarayı eksiksiz giriniz."); return; }

                const editId = document.getElementById('editKayitId').value;
                const methodType = editId ? 'PUT' : 'POST';
                const paketSayisi = editId ? 1 : parseInt(document.getElementById('kayitPaket').value) || 1;
                const secilenGunler = Array.from(document.querySelectorAll('.gun-secim-btn:checked')).map(cb => parseInt(cb.value));

                if (!editId && paketSayisi > 1 && secilenGunler.length === 0) {
                    alert("Lütfen paketin dizileceği en az bir ders günü seçiniz.");
                    return;
                }

                const finalIsim = isimFormatla(document.getElementById('kayitAdi').value);
                const brans = document.getElementById('kayitBrans').value;
                const format = seciliFormatGetir();
                const dersTuru = birlesikDersTuruOlustur(brans, format);

                const uyelerPayload = [{
                    kisiAdi: finalIsim,
                    telefon: guncelTel,
                    cinsiyet: document.getElementById('kayitCinsiyet').value
                }];

                if (!editId && format === 'grup') {
                    const ekSatirlar = Array.from(document.querySelectorAll('#ekUyeSatirlari .ek-uye-satir'));
                    for (const satir of ekSatirlar) {
                        const ad = isimFormatla(satir.querySelector('.ek-uye-ad').value);
                        const tel = satir.querySelector('.ek-uye-tel').value;
                        const cins = satir.querySelector('.ek-uye-cinsiyet').value;
                        if (!ad) {
                            alert("Eklenen grup üyesinin adını giriniz veya satırı kaldırınız.");
                            return;
                        }
                        if (tel && tel.length < 14) {
                            alert(`${ad} için telefon numarasını eksiksiz giriniz.`);
                            return;
                        }
                        uyelerPayload.push({ kisiAdi: ad, telefon: tel, cinsiyet: cins });
                    }
                }

                const gorulenAdlar = new Set();
                const gorulenTeller = new Set();
                for (const u of uyelerPayload) {
                    const adKey = u.kisiAdi.toLocaleLowerCase('tr-TR');
                    const telKey = (u.telefon || '').replace(/\D/g, '');
                    if (gorulenAdlar.has(adKey) || (telKey.length >= 10 && gorulenTeller.has(telKey))) {
                        alert(`${u.kisiAdi} listede birden fazla kez girilmiş. Lütfen kontrol ediniz.`);
                        return;
                    }
                    gorulenAdlar.add(adKey);
                    if (telKey.length >= 10) gorulenTeller.add(telKey);
                }

                btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> İŞLENİYOR...';

                try {
                    const payloadObj = { 
                        id: editId,
                        kortNo: document.getElementById('kayitKort').value, 
                        tarih: editId ? document.getElementById('duzenleTarih').value : window.isoTarihFormat, 
                        saat: editId ? document.getElementById('duzenleSaat').value : document.getElementById('kayitSaat').value, 
                        kisiAdi: finalIsim, 
                        telefon: guncelTel, 
                        rezervasyonTuru: dersTuru, 
                        dersBransi: brans,
                        dersFormati: format,
                        cinsiyet: document.getElementById('kayitCinsiyet').value,
                        uyeler: uyelerPayload,
                        ekleyen: document.getElementById('kayitUzman').value,
                        paketSayisi: paketSayisi,
                        secilenGunler: secilenGunler,
                        onayDurumu: 'onaylandi'
                    };

                    const response = await fetch('/api/rezervasyon', {
                        method: methodType,
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payloadObj)
                    });

                    const sonuc = await response.json();

                    if (response.ok) {
                        if(window.myModal) window.myModal.hide();
                        await tabloyuCiz();

                        let wpUrl = null;
                        if (methodType === 'POST') {
                            const [yil, ay, gun] = window.isoTarihFormat.split('-');
                            const konumLinki = `${window.location.origin}/konum`;
                            const paketNotu = paketSayisi > 1 ? ` (${paketSayisi} derslik paket programınız oluşturuldu)` : '';
                            const wpMesaj = `Sayın ${finalIsim},\n\n${gun}.${ay}.${yil} tarihi saat ${document.getElementById('kayitSaat').value} başlangıçlı Büşra Pilates Center Keçiören ${dersTuru} kaydınız oluşturulmuştur${paketNotu}.\n\n⚠️ Ders saatine 12 saat kala yapılan iptallerde ders hakkınız düşmektedir.\n📍 Konum: ${konumLinki}\n\nSağlıklı ve enerjik günler dileriz.`;
                            wpUrl = mmWpLink(guncelTel, wpMesaj);
                        }

                        if(typeof Swal !== 'undefined') {
                            let mesaj = 'Ders kaydı eklendi.';
                            if (editId) {
                                mesaj = 'Ders kaydı güncellendi.';
                            } else if (paketSayisi > 1) {
                                const tarihAraligi = sonuc.ilkTarih && sonuc.sonTarih
                                    ? ` (${sonuc.ilkTarih} – ${sonuc.sonTarih})`
                                    : '';
                                mesaj = uyelerPayload.length > 1
                                    ? `${uyelerPayload.length} kişilik grup için ${sonuc.basariliKayit} ders oluşturuldu${tarihAraligi}.`
                                    : `${sonuc.basariliKayit} derslik paket takvime dizildi${tarihAraligi}.`;
                            } else if (uyelerPayload.length > 1) {
                                mesaj = `${uyelerPayload.length} kişilik grup kaydı eklendi.`;
                            }

                            Swal.fire({
                                title: 'Başarılı!',
                                text: mesaj,
                                icon: 'success',
                                showCancelButton: !!wpUrl,
                                confirmButtonText: 'Tamam',
                                confirmButtonColor: '#6B4C63',
                                cancelButtonText: '<i class="fa-brands fa-whatsapp me-1"></i> WhatsApp ile Bildir',
                                cancelButtonColor: '#25D366'
                            }).then((res) => {
                                if (res.dismiss === Swal.DismissReason.cancel && wpUrl) {
                                    window.open(wpUrl, '_blank');
                                }
                            });
                        }
                    } else {
                        const cakismaListesi = Array.isArray(sonuc.cakismalar) ? sonuc.cakismalar : [];
                        if (typeof Swal !== 'undefined' && cakismaListesi.length > 0) {
                            const listeHtml = `<ul class="text-start small mb-0 ps-3">${cakismaListesi.map(c => `<li class="mb-1">${c}</li>`).join('')}</ul>`;
                            Swal.fire({
                                title: 'Kayıt Yapılamadı!',
                                html: `<p class="fw-semibold text-dark mb-2">${sonuc.error || 'Çakışan günler tespit edildi.'}</p>${listeHtml}`,
                                icon: 'error',
                                confirmButtonText: 'Düzenle',
                                confirmButtonColor: '#6B4C63'
                            });
                        } else {
                            const detayMetin = cakismaListesi.length > 0
                                ? `${sonuc.error}\n\n• ${cakismaListesi.join('\n• ')}`
                                : (sonuc.error || "İşlem başarısız.");
                            alert(detayMetin);
                        }
                    }
                } catch (error) { alert("Veritabanına bağlanılamadı."); } 
                finally { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-check-double me-2"></i> KAYDET'; }
            });
        }
    });

    window.mesajMerkeziAc = async function() {
        const btn = document.getElementById('mesajMerkeziBtn');
        if (btn) btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Yükleniyor...';

        try {
            const yarin = new Date();
            yarin.setDate(yarin.getDate() + 1);
            const yarinIso = new Date(yarin.getTime() - (yarin.getTimezoneOffset() * 60000)).toISOString().slice(0, 10);
            const yarinTr = yarin.toLocaleDateString('tr-TR', { day: '2-digit', month: 'long', year: 'numeric', weekday: 'long' });
            document.getElementById('mmYarinTarih').innerText = yarinTr;

            const [yarinRes, rehberRes, tumRezRes] = await Promise.all([
                fetch(`/api/rezervasyon?tarih=${yarinIso}`),
                fetch('/api/rehber'),
                fetch('/api/rezervasyon?tarih=hepsi')
            ]);

            const yarinKayitlar = await yarinRes.json();
            mmTumUyeler = await rehberRes.json();
            mmTumRez = await tumRezRes.json();

            const onaylilar = (yarinKayitlar || []).filter(k => k.onayDurumu === 'onaylandi' || !k.onayDurumu).sort((a, b) => a.saat.localeCompare(b.saat));
            document.getElementById('mmYarinSayac').innerText = onaylilar.length;
            const yarinDiv = document.getElementById('mmYarinListesi');
