                yarinDiv.innerHTML = '<div class="alert alert-light border text-center text-muted py-4">Yarın için kayıtlı ders bulunmuyor.</div>';
            } else {
                const konumLinki = `${window.location.origin}/konum`;
                yarinDiv.innerHTML = '<ul class="list-group list-group-flush border rounded-3">' + onaylilar.map(k => {
                    const mesaj = `Sayın ${k.kisiAdi},\n\nHatırlatma: Yarın (${yarinTr}) saat ${k.saat} için Büşra Pilates Center Keçiören'de ${k.rezervasyonTuru} dersiniz bulunmaktadır.\n\n📍 Konum: ${konumLinki}\n\nGörüşmek üzere!`;
                    const link = mmWpLink(k.telefon, mesaj);
                    return `<li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <div><strong class="d-block text-dark">${k.kisiAdi}</strong><small class="text-muted">${k.saat} — ${k.rezervasyonTuru}</small></div>
                        ${link ? `<a href="${link}" target="_blank" class="btn btn-sm btn-success fw-bold px-3 rounded-pill" onclick="this.innerHTML='Gönderildi ✓'; this.classList.replace('btn-success','btn-outline-secondary');"><i class="fa-brands fa-whatsapp me-1"></i> Gönder</a>` : '<span class="badge bg-secondary">Tel Yok</span>'}
                    </li>`;
                }).join('') + '</ul>';
            }

            const azalanlar = (mmTumUyeler || []).filter(m => {
                const kalan = (m.gelecekDers > 0) ? m.gelecekDers : (m.kalanDers || 0);
                const toplam = Math.max(m.toplamDers || 0, kalan);
                return toplam > 0 && kalan <= 2;
            });
            document.getElementById('mmPaketSayac').innerText = azalanlar.length;
            const paketDiv = document.getElementById('mmPaketListesi');
            if (azalanlar.length === 0) {
                paketDiv.innerHTML = '<div class="alert alert-light border text-center text-muted py-4">Paketi bitmek üzere olan üye bulunmuyor.</div>';
            } else {
                paketDiv.innerHTML = '<ul class="list-group list-group-flush border rounded-3">' + azalanlar.map(m => {
                    const kalan = (m.gelecekDers > 0) ? m.gelecekDers : (m.kalanDers || 0);
                    const mesaj = kalan === 0
                        ? `Sayın ${m.adSoyad},\n\nBüşra Pilates Center Keçiören'deki mevcut ders paketiniz tamamlanmıştır. Yeni dönem programınızı birlikte planlamak için bize yazabilirsiniz.\n\nSağlıklı günler dileriz.`
                        : `Sayın ${m.adSoyad},\n\nBüşra Pilates Center Keçiören'deki paketinizde son ${kalan} dersiniz kalmıştır. Yeni dönem gün ve saatlerinizi sabitlemek için bize dönüş yapabilirsiniz.\n\nSağlıklı günler dileriz.`;
                    const link = mmWpLink(m.telefon, mesaj);
                    return `<li class="list-group-item d-flex justify-content-between align-items-center py-2">
                        <div><strong class="d-block text-dark">${m.adSoyad}</strong><span class="badge bg-danger">Kalan: ${kalan} Ders</span></div>
                        ${link ? `<a href="${link}" target="_blank" class="btn btn-sm btn-success fw-bold px-3 rounded-pill" onclick="this.innerHTML='Gönderildi ✓'; this.classList.replace('btn-success','btn-outline-secondary');"><i class="fa-brands fa-whatsapp me-1"></i> Hatırlat</a>` : '<span class="badge bg-secondary">Tel Yok</span>'}
                    </li>`;
                }).join('') + '</ul>';
            }

            document.getElementById('mmSablonSec').onchange = function() {
                document.getElementById('mmTopluMetin').value = mmSablonlar[this.value] || '';
                if (this.value === 'kadinlar') document.getElementById('mmHedefKitle').value = 'kadin';
            };

            bootstrap.Modal.getOrCreateInstance(document.getElementById('mesajMerkeziModal')).show();
        } catch (err) {
            alert("Mesaj Merkezi verileri yüklenemedi.");
        } finally {
            if (btn) btn.innerHTML = '<i class="fa-brands fa-whatsapp me-1"></i> Mesaj Merkezi';
        }
    };

    window.mmKuyrukOlustur = function() {
        const metin = document.getElementById('mmTopluMetin').value.trim();
        const kitle = document.getElementById('mmHedefKitle').value;
        const div = document.getElementById('mmKuyrukListesi');
        if (!metin) { alert("Lütfen bir mesaj metni yazın veya şablon seçin."); return; }

        let liste = [...mmTumUyeler];
        if (kitle === 'aktif') {
            liste = liste.filter(m => (m.gelecekDers > 0) || (m.kalanDers > 0));
        } else if (kitle === 'kadin' || kitle === 'erkek') {
            liste = liste.filter(m => (m.cinsiyet || 'kadin') === kitle);
        } else if (egitmenByAnahtar(kitle)) {
            const hocaUyeleri = new Set(mmTumRez.filter(r => r.notlar === kitle).map(r => (r.kisiAdi || '').toLocaleLowerCase('tr-TR')));
            liste = liste.filter(m => hocaUyeleri.has((m.adSoyad || '').toLocaleLowerCase('tr-TR')));
        }

        const gorulenTel = new Set();
        const hazirListe = liste.filter(m => {
            const tel = (m.telefon || '').replace(/\D/g, '');
            if (tel.length < 10 || gorulenTel.has(tel)) return false;
            gorulenTel.add(tel);
            return true;
        });

        document.getElementById('mmKuyrukSayac').innerText = `${hazirListe.length} Kişi`;
        if (hazirListe.length === 0) {
            div.innerHTML = '<div class="alert alert-warning text-center small">Uygun üye bulunamadı.</div>';
            return;
        }

        div.innerHTML = '<ul class="list-group list-group-flush border rounded-3">' + hazirListe.map(m => {
            const link = mmWpLink(m.telefon, metin.replaceAll('{isim}', m.adSoyad));
            return `<li class="list-group-item d-flex justify-content-between align-items-center py-2">
                <div><strong class="d-block text-dark small">${m.adSoyad}</strong><small class="text-muted">${m.telefon}</small></div>
                <a href="${link}" target="_blank" class="btn btn-sm btn-success fw-bold px-3 rounded-pill" onclick="this.innerHTML='Gönderildi ✓'; this.classList.replace('btn-success','btn-outline-secondary');"><i class="fa-brands fa-whatsapp me-1"></i> Gönder</a>
            </li>`;
        }).join('') + '</ul>';
    };

    async function baslatSistemi() {
        if(typeof bootstrap !== 'undefined') {
            window.myModal = new bootstrap.Modal(document.getElementById('rezModal'));
            window.detayModal = new bootstrap.Modal(document.getElementById('detayModal'));
        }

        let baslangic = 9;
        let bitis = 22;

        try {
            const [ayarRes, egRes] = await Promise.all([
                fetch('/api/ayarlar-api'),
                fetch('/api/egitmenler')
            ]);

            if(ayarRes.ok) {
                const ayar = await ayarRes.json();
                baslangic = Math.max(6, parseInt(ayar.baslangicSaati || 9));
                bitis = Math.min(24, parseInt(ayar.bitisSaati || 22));
            }

            if(egRes.ok) {
                const tumEg = await egRes.json();
                window.aktifEgitmenler = (Array.isArray(tumEg) ? tumEg : []).filter(e => e.aktif);
            }
        } catch(err) {}

        if (window.aktifEgitmenler.length === 0) {
            window.aktifEgitmenler = [
                { id: 1, adSoyad: 'İlayda Hoca', anahtar: 'ilayda', baslangicSaati: 9, bitisSaati: 17, renk: '#6B4C63', aktif: true },
                { id: 2, adSoyad: 'Esra Hoca', anahtar: 'esra', baslangicSaati: 15, bitisSaati: 22, renk: '#9E6B8E', aktif: true },
                { id: 3, adSoyad: 'Büşra Hoca', anahtar: 'busra', baslangicSaati: 17, bitisSaati: 22, renk: '#E563B1', aktif: true }
            ];
        }

        window.alanSayisi = window.aktifEgitmenler.length;
        window.saatler = [];
        for(let i = baslangic; i < bitis; i++) {
            window.saatler.push(i.toString().padStart(2, '0') + ":00");
        }

        basliklariCiz();
        tarihiGuncelle(bugunYerelTarihStr());
    }

    function tarihDegistir(gf) { window.guncelTarih.setDate(window.guncelTarih.getDate() + gf); tarihiGuncelle(`${window.guncelTarih.getFullYear()}-${String(window.guncelTarih.getMonth() + 1).padStart(2, '0')}-${String(window.guncelTarih.getDate()).padStart(2, '0')}`); }
    
    function tarihiGuncelle(val) {
        if(!val) return;
        window.isoTarihFormat = val;
        const [yil, ay, gun] = val.split('-');
        window.guncelTarih = new Date(yil, ay - 1, gun);
        document.getElementById('gizliTakvim').value = window.isoTarihFormat;
        document.getElementById('gosterilenTarih').innerText = window.guncelTarih.toLocaleDateString('tr-TR', { day: '2-digit', month: 'short', year: 'numeric', weekday: 'long' });
        tabloyuCiz();
    }

    function izinSebepBul(aktifIzinler, saatStr, egitmen, kortNo) {
        const slotDk = saatDakikaToDk(saatStr);

        const tumIzin = aktifIzinler.find(iz => iz.kapsam === 'TUM');
        if (tumIzin) return tumIzin.sebep || 'Kapalı';

        const hocaIzin = aktifIzinler.find(iz => {
            const kapsamUyuyor = iz.kapsam === egitmen.anahtar || iz.kapsam === String(kortNo);
            if (!kapsamUyuyor) return false;
            if (iz.tip === 'tarih' || iz.tip === 'aralik' || iz.tip === 'rutin') return true;
            if (iz.tip === 'saatlik') {
                const [, sBas, sBit] = (iz.deger || '').split('_');
                return slotDk >= saatDakikaToDk(sBas) && slotDk < saatDakikaToDk(sBit);
            }
            return false;
        });

        if (hocaIzin) return hocaIzin.sebep || 'İzinli';
        return null;
    }

    async function tabloyuCiz() {
        const tbody = document.getElementById('tabloGövdesi');
        if(!tbody) return;
        const colSpan = window.alanSayisi + 1;
        tbody.innerHTML = `<tr><td colspan="${colSpan}" class="text-center py-5 text-muted fw-bold"><i class="fa-solid fa-spinner fa-spin me-2" style="color: var(--manu-teal);"></i>Program Yükleniyor...</td></tr>`;
        
        try {
            const [rezRes, izinRes] = await Promise.all([ fetch(`/api/rezervasyon?tarih=${window.isoTarihFormat}`), fetch('/api/izinler') ]);
            const dbKayitlar = await rezRes.json();
            const kapaliKuralListesi = await izinRes.json();
            
            const kayitMap = {};
            if(Array.isArray(dbKayitlar)) {
                dbKayitlar.forEach(k => {
                    const key = `${k.saat}_${k.alanId}`;
                    if (!kayitMap[key]) kayitMap[key] = [];
                    kayitMap[key].push(k);
                });
            }

            tbody.innerHTML = ""; 
            const bugunTarihi = bugunYerelTarihStr();
            const isGecmisTarih = window.isoTarihFormat < bugunTarihi;
            const guncelGunIndex = window.guncelTarih.getDay();

            const aktifIzinler = Array.isArray(kapaliKuralListesi) ? kapaliKuralListesi.filter(iz => {
                if (iz.tip === 'tarih') return iz.deger === window.isoTarihFormat;
                if (iz.tip === 'aralik') {
                    const [baslangic, bitis] = iz.deger.split('_');
                    return window.isoTarihFormat >= baslangic && window.isoTarihFormat <= bitis;
                }
                if (iz.tip === 'saatlik') {
                    const [izinTarih] = iz.deger.split('_');
                    return izinTarih === window.isoTarihFormat;
                }
                if (iz.tip === 'rutin') return parseInt(iz.deger, 10) === guncelGunIndex;
                return false;
            }) : [];

            window.saatler.forEach(saat => {
                const saatInt = parseInt(saat.split(':')[0], 10);
                let tr = document.createElement('tr');
                tr.innerHTML = `<td class="time-cell">${saat}</td>`;
                
                for (let kort = 1; kort <= window.alanSayisi; kort++) {
                    const egitmen = egitmenByKort(kort);
                    let kortKapaliSebep = izinSebepBul(aktifIzinler, saat, egitmen, kort);

                    if (!kortKapaliSebep) {
                        const bas = parseInt(egitmen.baslangicSaati ?? 9, 10);
                        const bit = parseInt(egitmen.bitisSaati ?? 22, 10);
                        if (saatInt < bas || saatInt >= bit) {
                            kortKapaliSebep = "Mesai Dışı";
                        }
                    }

                    if (kortKapaliSebep) {
                        let td = document.createElement('td');
                        td.className = 'cell-closed shadow-sm';
                        const ikon = kortKapaliSebep === "Mesai Dışı" ? "fa-clock" : "fa-ban";
                        td.innerHTML = `<div class="h-100 w-100 d-flex flex-column justify-content-center align-items-center opacity-50"><i class="fa-solid ${ikon} mb-1"></i><span class="closed-title text-dark" style="font-size: 0.72rem;">${kortKapaliSebep}</span></div>`;
                        tr.appendChild(td);
                        continue; 
                    }

                    let slotKayitlari = kayitMap[`${saat}_${kort}`];
                    if (slotKayitlari && slotKayitlari.length > 0) {
                        let td = document.createElement('td');
                        td.className = 'cell-full shadow-sm';
                        const ilk = slotKayitlari[0];
                        const grupMu = isGrupKayit(ilk);
                        const bransKisa = kayitBransiniBul(ilk).replace(' Pilatesi', '').replace(' Pilates', '');
                        const bransIkon = bransIkonHtml(ilk);

                        if (grupMu) {
                            const doluRenk = slotKayitlari.length >= GRUP_KAPASITE ? 'bg-danger' : 'bg-success';
                            const isimlerHtml = slotKayitlari.map(k => {
                                const notIkon = (k.musteriNotu && k.musteriNotu.trim())
                                    ? `<i class="fa-solid fa-notes-medical text-danger ms-1" title="Sağlık / Eğitmen Notu Var"></i>`
                                    : '';
                                return `<span class="rez-name d-flex align-items-center" style="font-size: 0.75rem;">• ${isimFormatla(k.kisiAdi)} ${cinsiyetIkonHtml(k.cinsiyet, true)}${notIkon}</span>`;
                            }).join('');
                            td.innerHTML = `
                                <div class="h-100 w-100 p-1 text-start">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge ${doluRenk}" style="font-size: 0.65rem;">Grup ${slotKayitlari.length}/${GRUP_KAPASITE}</span>
                                        <span class="text-dark fw-semibold" style="font-size: 0.65rem;">${bransIkon}${bransKisa}</span>
                                    </div>
                                    ${isimlerHtml}
                                </div>`;
                        } else {
                            const notIkon = (ilk.musteriNotu && ilk.musteriNotu.trim())
                                ? `<i class="fa-solid fa-notes-medical text-danger ms-1" title="Sağlık / Eğitmen Notu Var"></i>`
                                : '';
                            td.innerHTML = `
                                <div class="h-100 w-100 p-1 text-start">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge" style="background-color: var(--manu-teal-light); font-size: 0.62rem;">Özel</span>
                                        <span class="text-dark fw-semibold" style="font-size: 0.65rem;">${bransIkon}${bransKisa}</span>
                                    </div>
                                    <span class="rez-name d-flex align-items-center fw-bold" style="font-size: 0.78rem;">${isimFormatla(ilk.kisiAdi)} ${cinsiyetIkonHtml(ilk.cinsiyet, true)}${notIkon}</span>
                                </div>`;
                        }
                        td.addEventListener('click', () => window.detayModalAc(slotKayitlari, kort, saat));
                        tr.appendChild(td);
                    } else {
                        let td = document.createElement('td');
                        td.className = 'cell-empty';
                        const gecmisSaat = slotGecmisSaatMi(window.isoTarihFormat, saat);
                        if (isGecmisTarih || gecmisSaat) {
                            td.style.cursor = "not-allowed";
                            td.style.backgroundColor = "#f8f9fa";
                            td.innerHTML = `<div class="w-100 h-100 d-flex justify-content-center align-items-center opacity-25"><i class="fa-solid fa-ban text-muted"></i></div>`;
                        } else {
                            td.innerHTML = `<button type="button" class="btn btn-sm btn-link p-0 w-100 h-100 shadow-none border-0" style="color: var(--manu-teal);"><i class="fa-solid fa-plus fs-5"></i></button>`;
                            td.addEventListener('click', () => window.ekleModalAc(kort, saat));
                        }
                        tr.appendChild(td);
                    }
                }
                tbody.appendChild(tr);
            });
        } catch (err) { tbody.innerHTML = `<tr><td colspan="${colSpan}" class="text-center py-5 text-danger fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>Veritabanı bağlantı hatası!</td></tr>`; }
    }

    window.ekleModalAc = function(kortNo, saat, sabitTur = null, sabitGunler = null, mevcutKisi = 0) {
        if (slotGecmisSaatMi(window.isoTarihFormat, saat)) {
            alert("Bugün için geçmiş saate ders kaydı açılamaz.");
            return;
        }

        window.mevcutGrupKisiSayisi = mevcutKisi || 0;
        document.getElementById('duzenleTasimaAlani').classList.add('d-none');
        document.getElementById('editKayitId').value = ""; 
        document.getElementById('kayitSaat').value = saat;
        document.getElementById('kayitKort').value = kortNo;
        document.getElementById('kayitAdi').value = ""; 
        document.getElementById('kayitTelefon').value = "";
        document.getElementById('kayitCinsiyet').value = "kadin";
        document.getElementById('kayitPaket').value = "1";
        document.getElementById('paketSecimAlani').classList.remove('d-none');
        document.getElementById('gunSecimKutusu').classList.add('d-none');

        const bugunGun = window.guncelTarih.getDay();
        const gunAdlari = { 1: 'Pzt', 2: 'Sal', 3: 'Çar', 4: 'Per', 5: 'Cum', 6: 'Cmt' };
        const gunNotu = document.getElementById('gunSecimNotu');
        const gecerliSabitGunler = (sabitGunler || []).filter(g => g >= 1 && g <= 6);

        if (gecerliSabitGunler.length > 0) {
            document.querySelectorAll('.gun-secim-btn').forEach(cb => {
                const val = parseInt(cb.value);
                cb.checked = gecerliSabitGunler.includes(val);
                cb.disabled = true;
            });
            const gunMetni = gecerliSabitGunler.sort().map(g => gunAdlari[g]).join(', ');
            gunNotu.innerHTML = `<strong style="color: var(--manu-teal);">* Bu grubun ders günleri sabitlendi: ${gunMetni}</strong>`;
        } else {
            document.querySelectorAll('.gun-secim-btn').forEach(cb => {
                const val = parseInt(cb.value);
                cb.checked = (val === bugunGun);
                cb.disabled = (val === bugunGun);
            });
            gunNotu.innerText = "* Seçilen günlerde doluluk veya izin varsa kayıt yapılmaz ve detay gösterilir.";
        }

        const egitmen = egitmenByKort(kortNo);
        document.getElementById('kaydetBtn').innerHTML = '<i class="fa-solid fa-check-double me-2"></i> KAYDET';
        document.getElementById('rezModalBaslik').innerHTML = '<i class="fa-solid fa-calendar-plus me-2" style="color: var(--manu-gold);"></i>Yeni Ders Kaydı';
        
        document.getElementById('modalKortBadge').innerText = egitmen.adSoyad;
        document.getElementById('modalSaatBadge').innerText = 'Saat: ' + saat;
        document.getElementById('modalTarihMetni').innerText = document.getElementById('gosterilenTarih').innerText;
        
        const bransSelect = document.getElementById('kayitBrans');
        const grupRadio = document.getElementById('formatGrup');
        const ozelRadio = document.getElementById('formatOzel');

        if (sabitTur) {
            const ornekKayit = { rezervasyonTuru: sabitTur };
            bransSelect.value = kayitBransiniBul(ornekKayit);
            const sabitFormat = kayitFormatiniBul(ornekKayit);
            seciliFormatAta(sabitFormat);
            bransSelect.disabled = true;
            grupRadio.disabled = true;
            ozelRadio.disabled = true;
        } else {
            bransSelect.value = 'Reformer Pilates';
            seciliFormatAta('grup');
            bransSelect.disabled = false;
            grupRadio.disabled = false;
            ozelRadio.disabled = false;
        }

        const uzmanSelect = document.getElementById('kayitUzman');
        uzmanSelect.value = egitmen.anahtar;
        uzmanSelect.disabled = true;

        grupUyeleriSifirla();

        if(window.myModal) window.myModal.show();
    };

    window.detayModalAc = function(kayitlar, kortNo, saat) {
        window.aktifSlotKayitlari = kayitlar; 
        const ilk = kayitlar[0];
        const grupMu = isGrupKayit(ilk);
        const egitmen = egitmenByKort(kortNo);

        document.getElementById('detayModalBaslik').innerHTML = grupMu
            ? `<i class="fa-solid fa-users me-2" style="color: var(--manu-gold);"></i>Grup Dersi (${kayitlar.length}/${GRUP_KAPASITE})`
            : `<i class="fa-solid fa-circle-info me-2" style="color: var(--manu-gold);"></i>Ders Detayı`;

        document.getElementById('detayKortBadge').innerText = egitmen.adSoyad;
        document.getElementById('detaySaatBadge').innerText = 'Saat: ' + saat;
        document.getElementById('detayTarihMetni').innerText = document.getElementById('gosterilenTarih').innerText;

        const bugunTarihi = bugunYerelTarihStr();
        const isGecmis = window.isoTarihFormat < bugunTarihi;

        const listeDiv = document.getElementById('detayUyeListesi');
        listeDiv.innerHTML = '';

        kayitlar.forEach((k, idx) => {
            const [yil, ay, gun] = (k.tarih || window.isoTarihFormat).split('-');
            const konumLinki = `${window.location.origin}/konum`;
            const wpMesaj = `Sayın ${isimFormatla(k.kisiAdi)},\n\n${gun}.${ay}.${yil} tarihi saat ${k.saat} için Büşra Pilates Center Keçiören'de bulunan ${k.rezervasyonTuru} dersinizi hatırlatmak isteriz.\n\n📍 Konum: ${konumLinki}\n\nSağlıklı günler dileriz.`;
            const wpLink = mmWpLink(k.telefon, wpMesaj);

            const wpButonu = wpLink
                ? `<a href="${wpLink}" target="_blank" class="btn btn-sm btn-success fw-bold" title="WhatsApp Mesajı Gönder"><i class="fa-brands fa-whatsapp"></i></a>`
                : '';

            const butonlar = isGecmis ? '' : `
                <div class="d-flex gap-1 mt-2">
                    <button type="button" class="btn btn-sm btn-outline-warning fw-bold flex-fill" onclick="window.kayitDuzenleModunaGec(${idx})"><i class="fa-solid fa-pen me-1"></i> Düzenle</button>
                    <button type="button" class="btn btn-sm btn-outline-danger fw-bold flex-fill" onclick="window.kayitSilOnay(${idx})"><i class="fa-solid fa-trash-can me-1"></i> İptal Et</button>
                    ${wpButonu}
                </div>`;

            const erkekMi = (k.cinsiyet || 'kadin') === 'erkek';
            const cinsiyetRozet = erkekMi
                ? `<span class="badge bg-primary-subtle text-primary border border-primary-subtle ms-1"><i class="fa-solid fa-mars me-1"></i>Erkek</span>`
                : `<span class="badge bg-danger-subtle text-danger border border-danger-subtle ms-1"><i class="fa-solid fa-venus me-1"></i>Kadın</span>`;

            const profilLinkHtml = k.musteriId
                ? `<a href="/uye/${k.musteriId}" class="fs-6 fw-bold text-decoration-none" style="color: var(--manu-teal);" title="Üye Profilini Aç"><i class="fa-solid fa-user me-1"></i> ${isimFormatla(k.kisiAdi)} <i class="fa-solid fa-arrow-up-right-from-square ms-1" style="font-size: 0.7rem; opacity: 0.6;"></i></a>`
                : `<strong class="fs-6" style="color: var(--manu-teal);"><i class="fa-solid fa-user me-1"></i> ${isimFormatla(k.kisiAdi)}</strong>`;

            const temizNot = (k.musteriNotu || '').trim().replace(/</g, '&lt;').replace(/>/g, '&gt;');
            const notKutusu = temizNot
                ? `<div class="mt-2 p-2 rounded-2 small" style="background-color: #fff3cd; border-left: 3px solid #ffc107; color: #664d03;">
                       <i class="fa-solid fa-notes-medical me-1 text-danger"></i><strong>Not:</strong> ${temizNot}
                   </div>`
                : '';

            listeDiv.innerHTML += `
                <div class="p-3 bg-light rounded-3 border">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center flex-wrap gap-1">
                            ${profilLinkHtml}
                            ${cinsiyetRozet}
                        </div>
                        <span class="badge bg-white text-dark border">${k.telefon || '-'}</span>
                    </div>
                    <small class="text-muted d-block mt-1">${bransIkonHtml(k)}${k.rezervasyonTuru}</small>
                    ${notKutusu}
                    ${butonlar}
                </div>`;
        });

        const grubaEkleBtn = document.getElementById('grubaEkleBtn');
        if (grupMu && !isGecmis && kayitlar.length < GRUP_KAPASITE) {
            grubaEkleBtn.classList.remove('d-none');
            grubaEkleBtn.onclick = async () => {
                grubaEkleBtn.disabled = true;
                grubaEkleBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> Grup Günleri Kontrol Ediliyor...';

                const grupGunleriSet = new Set([window.guncelTarih.getDay()]);
                try {
                    const res = await fetch('/api/rezervasyon?tarih=hepsi');
                    if (res.ok) {
                        const tumKayitlar = await res.json();
                        const gruptakiUyeler = new Set(kayitlar.map(k => k.kisiAdi.toLocaleLowerCase('tr-TR')));
                        const aktifFormat = kayitFormatiniBul(ilk);

                        tumKayitlar.forEach(k => {
                            if (
                                parseInt(k.alanId) === kortNo &&
                                k.saat === saat &&
                                kayitBransiniBul(k) === kayitBransiniBul(ilk) &&
                                kayitFormatiniBul(k) === aktifFormat &&
                                k.tarih >= window.isoTarihFormat &&
                                gruptakiUyeler.has((k.kisiAdi || '').toLocaleLowerCase('tr-TR'))
                            ) {
                                const [y, m, d] = k.tarih.split('-').map(Number);
                                grupGunleriSet.add(new Date(y, m - 1, d).getDay());
                            }
                        });
                    }
                } catch (e) {}

                grubaEkleBtn.disabled = false;
                grubaEkleBtn.innerHTML = '<i class="fa-solid fa-user-plus me-2"></i> BU GRUBA YENİ ÜYE EKLE';

                if (window.detayModal) window.detayModal.hide();
                window.ekleModalAc(kortNo, saat, ilk.rezervasyonTuru, Array.from(grupGunleriSet), kayitlar.length);
            };
        } else {
            grubaEkleBtn.classList.add('d-none');
        }

        if(window.detayModal) window.detayModal.show();
    };

    window.kayitDuzenleModunaGec = function(idx) {
        if(window.detayModal) window.detayModal.hide(); 
        const kayit = window.aktifSlotKayitlari[idx];
        window.mevcutGrupKisiSayisi = 0;
        document.getElementById('editKayitId').value = kayit.id; 
        document.getElementById('kayitSaat').value = kayit.saat;
        const kortNo = parseInt(kayit.alanId);
        document.getElementById('kayitKort').value = kortNo;
        document.getElementById('kayitAdi').value = isimFormatla(kayit.kisiAdi);
        document.getElementById('kayitTelefon').value = kayit.telefon || "";
        document.getElementById('kayitCinsiyet').value = kayit.cinsiyet || "kadin";
        grupUyeleriSifirla();
        
        const bransSelect = document.getElementById('kayitBrans');
        const grupRadio = document.getElementById('formatGrup');
        const ozelRadio = document.getElementById('formatOzel');
        bransSelect.value = kayitBransiniBul(kayit);
        seciliFormatAta(kayitFormatiniBul(kayit));
        const kilitli = window.aktifSlotKayitlari.length > 1;
        bransSelect.disabled = kilitli;
        grupRadio.disabled = kilitli;
        ozelRadio.disabled = kilitli;

        const egitmen = egitmenByAnahtar(kayit.notlar) || egitmenByKort(kortNo);
        const uzmanSelect = document.getElementById('kayitUzman');
        uzmanSelect.value = egitmen.anahtar;
        uzmanSelect.disabled = (window.aktifRol !== 'yonetici');

        document.getElementById('duzenleTarih').value = kayit.tarih;
        const saatSelect = document.getElementById('duzenleSaat');
        saatSelect.innerHTML = window.saatler.map(s => `<option value="${s}" ${s === kayit.saat ? 'selected' : ''}>${s}</option>`).join('');
        document.getElementById('duzenleTasimaAlani').classList.remove('d-none');

        document.getElementById('paketSecimAlani').classList.add('d-none');
        
        document.getElementById('modalKortBadge').innerText = egitmen.adSoyad;
        document.getElementById('modalSaatBadge').innerText = 'Saat: ' + kayit.saat;
        document.getElementById('modalTarihMetni').innerText = document.getElementById('gosterilenTarih').innerText;

        document.getElementById('rezModalBaslik').innerHTML = '<i class="fa-solid fa-pen-to-square me-2" style="color: var(--manu-gold);"></i>Dersi Düzenle / Taşı';
        document.getElementById('kaydetBtn').innerHTML = '<i class="fa-solid fa-floppy-disk me-2"></i> GÜNCELLE';
        
        if(window.myModal) window.myModal.show(); 
    };

    window.kayitSilOnay = function(idx) {
        const kayit = window.aktifSlotKayitlari[idx];
        if (!kayit) return;

        if (window.detayModal) window.detayModal.hide();

        document.getElementById('iptalUyeBilgi').innerText = `${isimFormatla(kayit.kisiAdi)} — ${kayit.tarih} / ${kayit.saat}`;

        const [y, m, d] = kayit.tarih.split('-').map(Number);
        const [saatNum, dkNum] = kayit.saat.split(':').map(Number);
        const dersZamani = new Date(y, m - 1, d, saatNum, dkNum || 0);
        const kalanSaat = Math.round((dersZamani.getTime() - Date.now()) / (1000 * 60 * 60));

        const uyariDiv = document.getElementById('iptal12SaatUyari');
        const hakSelect = document.getElementById('iptalHakSecim');
        const telafiOpt = hakSelect.querySelector('option[value="telafi"]');

        if (kayit.seriId) {
            document.getElementById('iptalSeriAlani').classList.remove('d-none');
            telafiOpt.disabled = false;
            telafiOpt.hidden = false;
        } else {
            document.getElementById('iptalSeriAlani').classList.add('d-none');
            telafiOpt.disabled = true;
            telafiOpt.hidden = true;
        }

        document.getElementById('iptalKapsam').value = 'tek';
        document.getElementById('iptalHakAlani').classList.remove('d-none');

        if (kalanSaat >= 12) {
            uyariDiv.className = 'alert alert-success py-2 small fw-bold mb-3';
            uyariDiv.innerHTML = `<i class="fa-solid fa-circle-check me-1"></i> Derse ${kalanSaat} saat var (12 saat kuralına uygun). Hak iadesi veya telafi önerilir.`;
            hakSelect.value = kayit.seriId ? 'telafi' : 'evet';
        } else {
            uyariDiv.className = 'alert alert-warning py-2 small fw-bold mb-3';
            uyariDiv.innerHTML = `<i class="fa-solid fa-triangle-exclamation me-1"></i> Derse 12 saatten az kaldı (${Math.max(0, kalanSaat)} saat). Kural gereği ders hakkı yanabilir.`;
            hakSelect.value = 'hayir';
        }

        document.getElementById('iptalKapsam').onchange = function() {
            const hakAlani = document.getElementById('iptalHakAlani');
            if (this.value === 'seri') hakAlani.classList.add('d-none');
            else hakAlani.classList.remove('d-none');
        };

        const iptalModalEl = document.getElementById('iptalModal');
        const iptalModalInst = bootstrap.Modal.getOrCreateInstance(iptalModalEl);
        iptalModalInst.show();

        const onaylaBtn = document.getElementById('iptalOnaylaBtn');
        onaylaBtn.onclick = async () => {
            const kapsam = kayit.seriId ? document.getElementById('iptalKapsam').value : 'tek';
            const hakIade = kapsam === 'seri' ? 'hayir' : document.getElementById('iptalHakSecim').value;

            onaylaBtn.disabled = true;
            onaylaBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> İŞLENİYOR...';

            try {
                const response = await fetch(`/api/rezervasyon?id=${kayit.id}&kapsam=${kapsam}&hakIade=${hakIade}`, { method: 'DELETE' });
                const sonuc = await response.json();

                if (response.ok) {
                    iptalModalInst.hide();
                    await tabloyuCiz();

                    const [yil, ay, gun] = kayit.tarih.split('-');
                    const telafiNotu = sonuc.telafiTarih ? `\nTelafi dersiniz ${sonuc.telafiTarih} tarihine planlanmıştır.` : '';
                    const iptalMesaji = `Sayın ${isimFormatla(kayit.kisiAdi)},\n\n${gun}.${ay}.${yil} tarihi saat ${kayit.saat} için Büşra Pilates Center Keçiören'de bulunan dersiniz iptal edilmiştir.${telafiNotu}\n\nSağlıklı günler dileriz.`;
                    const wpLink = mmWpLink(kayit.telefon, iptalMesaji);

                    if (typeof Swal !== 'undefined') {
                        const ozet = kapsam === 'seri'
                            ? 'Bu ve sonraki tüm paket dersleri iptal edildi.'
                            : (sonuc.telafiTarih ? `Ders iptal edildi. Telafi dersi otomatik olarak ${sonuc.telafiTarih} tarihine eklendi.` : 'Ders iptal edildi.');
                        Swal.fire({
                            title: 'İptal Edildi',
                            text: ozet,
                            icon: 'success',
                            showCancelButton: !!wpLink,
                            confirmButtonText: 'Tamam',
                            confirmButtonColor: '#6B4C63',
                            cancelButtonText: '<i class="fa-brands fa-whatsapp me-1"></i> WhatsApp ile Bildir',
                            cancelButtonColor: '#25D366'
                        }).then((res) => {
                            if (res.dismiss === Swal.DismissReason.cancel && wpLink) {
                                window.open(wpLink, '_blank');
                            }
                        });
                    }
                } else {
                    alert(sonuc.error || "Hata oluştu.");
                }
            } catch (e) {
                alert("Sunucu hatası.");
            } finally {
                onaylaBtn.disabled = false;
                onaylaBtn.innerHTML = '<i class="fa-solid fa-check me-1"></i> İPTALİ ONAYLA';
            }
        };
    };
</script>

<div class="modal fade" id="sifreModal" tabindex="-1">
